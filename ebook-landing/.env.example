# --- monday.com ---
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=5105685497
# Optional: group for new leads (topics = "New Leads")
MONDAY_GROUP_ID=topics
# Optional: pin the monday API version (default 2026-07)
MONDAY_API_VERSION=

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. guide@yourdomain.com
FROM_EMAIL=
# Optional: where replies go (your real inbox)
REPLY_TO_EMAIL=
# Optional but recommended: gets an alert email if saving to monday.com ever fails
NOTIFY_EMAIL=
