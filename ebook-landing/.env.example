# --- Google Sheets lead storage ---
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace-with-your-webhook-secret

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend, e.g. guide@yourdomain.com
FROM_EMAIL=
# Optional: where replies go (your real inbox)
REPLY_TO_EMAIL=
# Your WhatsApp number, digits only with country code, e.g. 2348012345678 (adds the WhatsApp button to the email)
WHATSAPP_NUMBER=
# Optional: receives an alert if a lead cannot be saved to the sheet
NOTIFY_EMAIL=
