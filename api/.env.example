# --- DataStax Astra DB (Data API) ---
# Required when DEV_MEMORY_DB=0. For local dev, keep DEV_MEMORY_DB=1 and skip Astra.
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...

# Local development without Astra: set to 1 to use an in-memory store (data is lost on restart)
# This is safe for local testing only; do not use in production.
DEV_MEMORY_DB=1

# --- Security ---
# Shared secret between the Next.js server and this API (long random string)
API_SHARED_SECRET=replace-with-long-random-string
# Key for /v1/admin/* endpoints (content management + reading leads)
ADMIN_API_KEY=replace-with-admin-key
# Comma-separated list of allowed browser origins (only needed if browsers call the API directly)
WEB_ORIGINS=http://localhost:3000

# --- Optional: notify a webhook (n8n, Zapier, Slack, etc.) on every new lead ---
LEAD_WEBHOOK_URL=
