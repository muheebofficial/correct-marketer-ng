# Public site URL (used for canonicals, sitemap, Open Graph)
# For local dev, set this to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# OneSignal web push (use a separate OneSignal app for localhost)
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NOTIFY_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-a-different-long-random-string

# Python API (server-side only - never exposed to the browser)
# Must match the API_SHARED_SECRET in api/.env exactly.
API_URL=http://localhost:8000
API_SHARED_SECRET=replace-with-the-same-long-random-string

# Ebook lead capture and delivery (server-side only)
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=5105685497
MONDAY_GROUP_ID=topics
MONDAY_API_VERSION=2026-07
MONDAY_OWNER_USER_ID=118911616
RESEND_API_KEY=
FROM_EMAIL=
REPLY_TO_EMAIL=
NOTIFY_EMAIL=

# Internal admin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_COOKIE_SECRET=replace-with-a-random-secret

# Analytics (leave blank to disable; loaded only after the visitor accepts cookies)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Search Console verification token (the content="" value of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
