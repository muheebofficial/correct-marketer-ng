# Public site URL (used for canonicals, sitemap, Open Graph)
# For local dev, set this to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Python API (server-side only - never exposed to the browser)
# Must match the API_SHARED_SECRET in api/.env exactly.
API_URL=http://localhost:8000
API_SHARED_SECRET=replace-with-the-same-long-random-string

# Analytics (leave blank to disable; loaded only after the visitor accepts cookies)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Search Console verification token (the content="" value of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
